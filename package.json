{
  "name": "hmbee-bot",
  "version": "0.1.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "map:tochka": "npx tsx scripts/tochka-mapping.js",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts"
  },
  "keywords": [],
  "author": "Andrey Khataev",
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/json-logic-js": "2.0.8",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "esbuild": "0.28.1",
    "ts-node": "10.9.2",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@types/node-fetch": "2.6.13",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "json-logic-js": "2.0.5",
    "node-fetch": "2.7.0",
    "zod": "4.4.2"
  }
}
