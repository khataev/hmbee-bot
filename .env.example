# Optional fallback: normally the session cookie is read automatically from a running
# Firefox's session store (requires an active i.tochka.com login). Only set this if that's
# unavailable (Firefox not installed/running, or the session cookie can't be found there).
TOCHKA_COOKIE=
TOCHKA_CUSTOMER_ID=
TOCHKA_PAGE_SIZE=250
HM_USER_EMAIL=
HM_USER_TOKEN=
HM_API_BASE_URL=https://app1.hmbee.ru/api
HM_SOURCE=HM3
